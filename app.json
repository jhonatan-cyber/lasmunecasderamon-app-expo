{
  "expo": {
    "name": "lasmunecasderamon-app",
    "slug": "lasmunecasderamon-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo1.png",
    "scheme": "lasmunecasderamon",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/ef39814f-d1f7-444c-bc30-598055b8595e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lasmunecasderamon.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Permite el acceso a Face ID para iniciar sesión de forma segura.",
        "NSCameraUsageDescription": "Permite el acceso a la cámara para registrar tu asistencia mediante QR.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:dashboard.xn--lasmuecasderamon-bub.com"
      ]
    },
    "android": {
      "package": "com.lasmunecasderamon.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo1.png",
        "backgroundImage": "./assets/images/logo1.png",
        "monochromeImage": "./assets/images/logo1.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "lasmunecasderamon"
            },
            {
              "scheme": "https",
              "host": "dashboard.xn--lasmuecasderamon-bub.com",
              "pathPrefix": "/app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo1.png"
    },
    "plugins": [
      "expo-router",
      "expo-build-properties",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo1.png",
          "color": "#8B5CF6"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo1.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite el acceso a Face ID para iniciar sesión de forma segura."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permite el acceso a la cámara para registrar tu asistencia mediante QR."
        }
      ],
      "@sentry/react-native",
      "expo-font",
      "expo-sharing",
      "expo-sqlite",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ef39814f-d1f7-444c-bc30-598055b8595e"
      }
    },
    "owner": "nuwe"
  }
}
