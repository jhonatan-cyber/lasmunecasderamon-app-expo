{
  "name": "lasmunecasderamon-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "start:remote": "node scripts/start-dev-remote.js",
    "start:go": "expo start",
    "start:tunnel": "expo start --dev-client --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "verify:metro": "expo export --platform web --output-dir .expo-smoke",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:dev": "npx eas-cli build --profile development --platform android",
    "android:preview": "npx eas-cli build --profile preview_apk --platform android",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "npx --yes expo-doctor@1.20.4",
    "verify:prebuild": "pnpm lint && pnpm typecheck && pnpm run doctor",
    "verify:release": "pnpm verify:prebuild && pnpm test:e2e:smoke",
    "build:web": "expo export --platform web",
    "build:analyze": "expo export --platform web --dump-sourcemap && node ./scripts/analyze-bundle.js",
    "smoke:web": "expo export --platform web --output-dir .expo-smoke",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e:smoke": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "57.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@lasmunecasderamon/config": "workspace:*",
    "@lasmunecasderamon/sale-totals": "workspace:*",
    "@lasmunecasderamon/types": "workspace:*",
    "@lasmunecasderamon/utils": "workspace:*",
    "@lasmunecasderamon/validations": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sentry/react-native": "^7.11.0",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "^57.0.20",
    "expo-intent-launcher": "^57.0.1",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-navigation-bar": "~57.0.3",
    "expo-network": "^57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "^57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "^57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-updates": "~57.0.25",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/traverse--for-generate-function-map": "npm:@babel/traverse@7.29.7",
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.60.0",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.16",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "happy-dom": "^20.9.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "undici": "^8.5.0",
    "vite": "7.3.5",
    "vitest": "^4.1.11"
  },
  "private": true,
  "packageManager": "pnpm@10.28.2"
}
