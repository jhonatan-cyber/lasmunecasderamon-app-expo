{
  "name": "lasmunecasderamon-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "start:tunnel": "expo start --dev-client --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "postinstall": "node ./scripts/patch-expo-web.js",
    "verify:metro": "node ./scripts/verify-metro-start.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:dev": "npx eas-cli build --profile development --platform android",
    "android:preview": "npx eas-cli build --profile preview_apk --platform android",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "verify:prebuild": "pnpm lint && pnpm typecheck && pnpm doctor",
    "verify:release": "pnpm verify:prebuild && pnpm test:e2e:smoke",
    "build:web": "expo export --platform web",
    "build:analyze": "expo export --platform web --dump-sourcemap && node ./scripts/analyze-bundle.js",
    "smoke:web": "expo export --platform web --output-dir .expo-smoke",
    "test:e2e:smoke": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "56.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@lasmunecasderamon/config": "workspace:*",
    "@lasmunecasderamon/sale-totals": "workspace:*",
    "@lasmunecasderamon/types": "workspace:*",
    "@lasmunecasderamon/utils": "workspace:*",
    "@lasmunecasderamon/validations": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sentry/react-native": "^7.11.0",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~56.0.15",
    "expo-build-properties": "~56.0.22",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.20",
    "expo-dev-client": "~56.0.22",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image-picker": "^56.0.20",
    "expo-intent-launcher": "^56.0.4",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.15",
    "expo-local-authentication": "~56.0.4",
    "expo-navigation-bar": "~56.0.3",
    "expo-network": "^56.0.5",
    "expo-notifications": "~56.0.20",
    "expo-print": "~56.0.4",
    "expo-router": "~56.2.14",
    "expo-secure-store": "^56.0.4",
    "expo-sharing": "~56.0.21",
    "expo-speech": "~56.0.3",
    "expo-splash-screen": "~56.0.12",
    "expo-sqlite": "^56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-updates": "~56.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/traverse--for-generate-function-map": "npm:@babel/traverse@7.29.7",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.16",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "happy-dom": "^20.9.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "react-test-renderer": "19.2.7",
    "typescript": "~6.0.3",
    "undici": "^8.5.0",
    "vitest": "^4.1.8"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.11",
      "flatted": ">=3.4.1",
      "undici": ">=8.5.0",
      "node-forge": ">=1.4.0",
      "picomatch": "^2.3.2",
      "@xmldom/xmldom": ">=0.8.13",
      "fast-uri": ">=3.1.2"
    },
    "ignoredBuiltDependencies": [
      "@sentry/cli",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.28.2"
}
