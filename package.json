{
  "name": "lasmunecasderamon-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "start:remote": "node scripts/start-dev-remote.js",
    "start:go": "node scripts/start-dev-clean-env.js --go",
    "start:tunnel": "expo start --dev-client --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:dev": "npx eas-cli build --profile development --platform android",
    "android:preview": "npx eas-cli build --profile preview --platform android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "verify:clocks": "node scripts/verify-compiler-clocks.js",
    "doctor": "pnpm dlx expo-doctor@1.20.4",
    "verify:prebuild": "pnpm lint && pnpm typecheck && pnpm verify:clocks && pnpm run doctor",
    "verify:release": "pnpm verify:prebuild",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
