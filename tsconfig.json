{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@lasmunecasderamon/types": ["packages/types/src"],
      "@lasmunecasderamon/types/*": ["packages/types/src/*"],
      "@lasmunecasderamon/utils": ["packages/utils/src"],
      "@lasmunecasderamon/utils/*": ["packages/utils/src/*"],
      "@lasmunecasderamon/validations": ["packages/validations/src"],
      "@lasmunecasderamon/validations/*": ["packages/validations/src/*"],
      "@lasmunecasderamon/config": ["packages/config/src"],
      "@lasmunecasderamon/config/*": ["packages/config/src/*"],
      "@/*": ["*"],
      "@/components/*": ["components/*"],
      "@/hooks/*": ["hooks/*"],
      "@/api/*": ["api/*"],
      "@/store/*": ["store/*"],
      "@/constants/*": ["constants/*"],
      "@/utils/*": ["utils/*"],
      "@/context/*": ["context/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
