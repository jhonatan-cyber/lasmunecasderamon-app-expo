{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.19.0",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://dashboard.xn--lasmuecasderamon-bub.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "22.19.0",
      "environment": "preview"
    },
    "preview_apk": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://dashboard.xn--lasmuecasderamon-bub.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "node": "22.19.0",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://dashboard.xn--lasmuecasderamon-bub.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
