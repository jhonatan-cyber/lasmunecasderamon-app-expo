# Copiar a .env (no trackeado) y ajustar a tu red local.
# En dev con teléfono físico: IP LAN de tu PC (misma WiFi que el teléfono).
# Con emulador Android: 10.0.2.2. En web/simulador iOS: localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.7:3000

# Opcional: DSN de Sentry. Sin esto, el SDK no se inicializa (no-op).
# EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
